# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/sleepsync

# Frontend URL (for CORS config)
FRONTEND_URL=http://localhost:5173

# JWT Token Secrets
JWT_SECRET=super_secret_jwt_access_key_change_me_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_me_in_production

# Gemini AI API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
